{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/build"
      }
    }
  ],
  "routes": [
    {
      "src": "/demo-app/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/demo-app",
      "dest": "frontend/build/index.html"
    },
    {
      "src": "/demo-app/(.*)",
      "dest": "frontend/build/index.html"
    },
    {
      "src": "/",
      "status": 302,
      "headers": {
        "Location": "/demo-app"
      }
    }
  ]
}
