{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/demo-app/api/(.*)",
      "dest": "/backend/server.js"
    },
    {
      "src": "/demo-app/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|json|woff|woff2|ttf|eot))",
      "dest": "/frontend/$1"
    },
    {
      "src": "/demo-app/(.*)",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/demo-app",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/",
      "status": 301,
      "headers": {
        "Location": "/demo-app"
      }
    }
  ]
}
